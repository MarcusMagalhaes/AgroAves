# Copie para nfe/.env (que NÃO vai para o git) e preencha.
# Caminho do certificado A1 da empresa e senha. Nunca coloque o .pfx dentro do repositório.
NFE_PFX=/caminho/seguro/fora-do-repo/certificado.pfx
NFE_PFX_SENHA=
# 2 = homologação (o protótipo recusa qualquer outro valor)
NFE_AMBIENTE=2
# Série usada nos testes de homologação
NFE_SERIE=99
# Cadeia de certificados ICP-Brasil (PEM) para confiar no certificado do servidor da SEFAZ. Ver README.
NFE_CA_FILE=
